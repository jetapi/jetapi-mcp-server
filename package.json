{
  "name": "jetapi-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for JetAPI — send WhatsApp and Telegram messages from AI agents",
  "type": "module",
  "bin": {
    "jetapi-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector tsx src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jetapi/jetapi-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "jetapi",
    "whatsapp",
    "telegram",
    "messaging",
    "ai",
    "claude"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jetapi/jetapi-mcp-server/issues"
  },
  "homepage": "https://github.com/jetapi/jetapi-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "dotenv": "^17.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
